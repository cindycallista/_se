{
  "name": "fixtrack-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python server.py",
    "test:unit": "python -m unittest discover -s tests/unit -p test_*.py -v",
    "test:api": "python -m unittest discover -s tests/system -p test_*.py -v",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:api && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  },
  "license": "MIT"
}
